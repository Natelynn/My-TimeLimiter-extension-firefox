{
  "manifest_version": 3,
  "name": "Focus Manager — лимиты сайтов по интервалам",
  "version": "2.0.0",
  "description": "Разрешает ограниченное время на сайты из перечня в заданные интервалы (24-ч формат). Вне интервалов: полные блокировки или скрытие рекомендаций — по настройке для каждого сайта.",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background/alarm-worker.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_title": "Focus Manager",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "focus-manager@example.com",
      "strict_min_version": "109.0"
    }
  }
}
